{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-websites.local/schemas/site-config.schema.json",
  "title": "SiteConfig",
  "description": "Configuration schema for a local business website.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brand",
    "metadata",
    "nav",
    "hero",
    "services",
    "whyChooseUs",
    "contact",
    "footer"
  ],
  "properties": {
    "appearance": {
      "type": "string",
      "enum": [
        "default",
        "beauty",
        "zbrendiraj",
        "elektro",
        "construction",
        "cleaning",
        "health"
      ],
      "description": "Visual appearance category controlling layout and theme tokens."
    },
    "theme": {
      "type": "object",
      "description": "Per-site palette and font pairing assigned at generation time.",
      "additionalProperties": false,
      "required": ["paletteId", "fontPairingId"],
      "properties": {
        "paletteId": {
          "type": "string",
          "description": "Identifier for the assigned color palette."
        },
        "fontPairingId": {
          "type": "string",
          "description": "Identifier for the assigned heading/body font pairing."
        }
      }
    },
    "layout": {
      "type": "object",
      "description": "Optional layout profile (column order, image presence, ratios) for beauty and trade appearances.",
      "additionalProperties": false,
      "required": ["profileId"],
      "properties": {
        "profileId": {
          "type": "string",
          "enum": [
            "classic",
            "media-left",
            "copy-heavy",
            "services-first-visual",
            "airy",
            "stats-forward",
            "image-led",
            "calm-visual"
          ]
        },
        "heroImageSide": {
          "type": "string",
          "enum": ["left", "right", "none"]
        },
        "servicesImageSide": {
          "type": "string",
          "enum": ["left", "right", "none"]
        },
        "heroRatio": {
          "type": "string",
          "enum": ["5050", "6040", "full-copy"]
        },
        "benefitsMode": {
          "type": "string",
          "enum": ["default", "visual"]
        },
        "heroAtmosphere": {
          "type": "string",
          "enum": ["grid", "wash", "plain"]
        },
        "sectionRule": {
          "type": "string",
          "enum": ["line", "none"]
        },
        "cardStyle": {
          "type": "string",
          "enum": ["bordered", "soft"]
        }
      }
    },
    "images": {
      "type": "object",
      "description": "Per-site images assigned at generation time.",
      "additionalProperties": false,
      "required": ["hero", "services"],
      "properties": {
        "hero": { "$ref": "#/$defs/SiteImage" },
        "services": { "$ref": "#/$defs/SiteImage" }
      }
    },
    "brand": {
      "$ref": "#/$defs/Brand"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "nav": {
      "$ref": "#/$defs/Nav"
    },
    "hero": {
      "$ref": "#/$defs/Hero"
    },
    "services": {
      "$ref": "#/$defs/ServicesSection"
    },
    "whyChooseUs": {
      "$ref": "#/$defs/WhyChooseUsSection"
    },
    "contact": {
      "$ref": "#/$defs/ContactSection"
    },
    "footer": {
      "$ref": "#/$defs/Footer"
    },
    "business": {
      "$ref": "#/$defs/Business"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    }
  },
  "$defs": {
    "SiteImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "frame": {
          "type": "string",
          "enum": ["browser"]
        }
      }
    },
    "IconName": {
      "type": "string",
      "enum": [
        "building",
        "menu",
        "check",
        "location",
        "phone",
        "email",
        "clock",
        "service-1",
        "service-2",
        "service-3",
        "service-4",
        "service-5",
        "service-6"
      ]
    },
    "NavLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "label"],
      "properties": {
        "href": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "Service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "icon"],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/IconName"
        }
      }
    },
    "Benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "stat": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": ["warm", "dark", "minimal", "natural", "editorial", "premium"]
        },
        "image": {
          "$ref": "#/$defs/SiteImage"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "WhyChooseUsSteps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eyebrow", "title", "items"],
      "properties": {
        "id": { "type": "string" },
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "PricingNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ContactFaqItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" }
      }
    },
    "Stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "ContactItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "icon"],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/IconName"
        }
      }
    },
    "ContactForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "nameLabel",
        "namePlaceholder",
        "phoneLabel",
        "phonePlaceholder",
        "messageLabel",
        "messagePlaceholder",
        "submitLabel"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "nameLabel": {
          "type": "string"
        },
        "namePlaceholder": {
          "type": "string"
        },
        "phoneLabel": {
          "type": "string"
        },
        "phonePlaceholder": {
          "type": "string"
        },
        "messageLabel": {
          "type": "string"
        },
        "messagePlaceholder": {
          "type": "string"
        },
        "submitLabel": {
          "type": "string"
        }
      }
    },
    "Brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "highlight"],
      "properties": {
        "prefix": {
          "type": "string"
        },
        "highlight": {
          "type": "string"
        },
        "hideMonogram": {
          "type": "boolean"
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Nav": {
      "type": "object",
      "additionalProperties": false,
      "required": ["links", "cta"],
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NavLink"
          }
        },
        "cta": {
          "type": "string"
        }
      }
    },
    "Hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge",
        "title",
        "titleHighlight",
        "description",
        "primaryCta",
        "secondaryCta",
        "stats"
      ],
      "properties": {
        "badge": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleHighlight": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "primaryCta": {
          "type": "string"
        },
        "secondaryCta": {
          "type": "string"
        },
        "secondaryCtaHref": {
          "type": "string"
        },
        "stats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stat"
          }
        }
      }
    },
    "ServicesSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eyebrow", "title", "description", "items"],
      "properties": {
        "id": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Service"
          }
        },
        "pricing": {
          "$ref": "#/$defs/PricingNote"
        }
      }
    },
    "WhyChooseUsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eyebrow", "title", "description", "highlights", "benefits"],
      "properties": {
        "id": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Benefit"
          }
        },
        "steps": {
          "$ref": "#/$defs/WhyChooseUsSteps"
        }
      }
    },
    "ContactSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eyebrow", "title", "description", "items", "form"],
      "properties": {
        "id": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "faq": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContactFaqItem"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContactItem"
          }
        },
        "form": {
          "$ref": "#/$defs/ContactForm"
        }
      }
    },
    "Footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "rights"],
      "properties": {
        "address": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "managedBy": {
          "type": "string"
        }
      }
    },
    "Business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "email"],
      "properties": {
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "vatNumber": { "type": "string" }
      }
    },
    "Privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "lastUpdated",
        "contactForm",
        "analytics",
        "marketing",
        "booking",
        "thirdPartyEmbeds",
        "cookies"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "lastUpdated": { "type": "string" },
        "contactForm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "fields"],
          "properties": {
            "enabled": { "type": "boolean" },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["name", "phone", "message"]
              }
            }
          }
        },
        "analytics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider"],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": ["string", "null"] }
          }
        },
        "marketing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "booking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "type", "providerName", "url"],
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string", "enum": ["external_link"] },
            "providerName": { "type": "string" },
            "url": { "type": "string" },
            "privacyUrl": { "type": "string" }
          }
        },
        "thirdPartyEmbeds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["googleMaps", "youtube"],
          "properties": {
            "googleMaps": { "type": "boolean" },
            "youtube": { "type": "boolean" }
          }
        },
        "cookies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nonEssential"],
          "properties": {
            "nonEssential": { "type": "boolean" }
          }
        },
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    }
  }
}
